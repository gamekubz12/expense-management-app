// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Department {
  id   Int    @id @default(autoincrement())
  name String

  users User[] @relation("UserDepartment") // Employees in this department
}

model User {
  id            Int        @id @default(autoincrement())
  name          String
  email         String     @unique
  password      String
  role          Role
  department_id Int
  department    Department? @relation("UserDepartment", fields: [department_id], references: [id])
  created_at    DateTime   @default(now())

  expense_reports ExpenseReport[] @relation("ExpenseReportUser")
  review_reports  ExpenseReport[] @relation("ExpenseReportReviewer")
}

model ExpenseReport {
  id           Int      @id @default(autoincrement())
  user_id      Int
  title        String
  description  String
  status       Status
  submitted_at DateTime @default(now())
  reviewed_by  Int?
  reviewed_at  DateTime @default(now())
  user         User     @relation("ExpenseReportUser", fields: [user_id], references: [id])
  reviewer     User?    @relation("ExpenseReportReviewer", fields: [reviewed_by], references: [id])
}

enum Role {
  employee
  manager
  admin
}

enum Status {
  draft
  submitted
}
